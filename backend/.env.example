# Copy to .env and fill in. Never commit .env.

# Gemini (free tier for gemini-3.8-flash: 5 RPM, 20 RPD; keep a margin)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_RPM=4
GEMINI_DAILY_LIMIT=18
# Fallback while the main model fails or is out of quota (empty = no fallback).
# Free tier for gemini-3.5-flash-lite: 15 RPM, 50 RPD; keep a margin.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_RPM=12
GEMINI_FALLBACK_DAILY_LIMIT=45

# Summarization
SUMMARY_MIN_CHARS=500
SUMMARY_MAX_INPUT_CHARS=12000
SUMMARY_MAX_ATTEMPTS=5
SUMMARY_BATCH_SIZE=5

# Fetching: entries published longer ago than this are ignored
FETCH_MAX_AGE_HOURS=48

# Scheduler
FETCH_INTERVAL_MINUTES=60
SCHEDULER_ENABLED=true

# App
DATABASE_URL=sqlite:///./data/ai_news.db
ADMIN_API_KEY=
CORS_ORIGINS=["http://localhost:5173"]
